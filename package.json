{
  "name": "hetzner-mcp",
  "version": "0.2.4",
  "description": "Model Context Protocol server for the full Hetzner platform. Cloud (servers, networks, volumes, firewalls, load balancers, IPs, DNS), Storage Box, and Robot dedicated servers. Spin up and manage every part of Hetzner from any MCP client.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Mirza Iqbal",
  "homepage": "https://github.com/mjmirza/hetzner-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mjmirza/hetzner-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/mjmirza/hetzner-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hetzner",
    "hetzner-cloud",
    "hcloud",
    "storage-box",
    "robot",
    "dedicated-server",
    "infrastructure",
    "iac",
    "provisioning",
    "claude",
    "ai-agent"
  ],
  "bin": {
    "hetzner-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx test/smoke.ts",
    "eval": "tsx test/eval.ts",
    "verify:live": "npm run build && tsx test/fix-verify.ts",
    "validate:live": "npm run build && tsx test/live-validate.ts",
    "deploy:demo": "npm run build && tsx scripts/deploy-demo.ts",
    "teardown:demo": "npm run build && tsx scripts/teardown-demo.ts",
    "hygiene": "npx -y fallow@2.88.2 dead-code --baseline .fallow-baseline.json",
    "hygiene:baseline": "npx -y fallow@2.88.2 dead-code --save-baseline .fallow-baseline.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
