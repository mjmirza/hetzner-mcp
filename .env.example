# Hetzner MCP configuration. Copy to .env and fill in. Never commit .env.

# Cloud API token from https://console.hetzner.com  (Security, API Tokens).
# This same token also authenticates the Storage Box API.
HETZNER_CLOUD_TOKEN=

# Robot webservice credentials from https://robot.hetzner.com
# (Settings, Web service and app settings). Optional, only for dedicated servers.
HETZNER_ROBOT_USER=
HETZNER_ROBOT_PASSWORD=

# Safety. billed-resource creation requires this to be exactly 1 AND a per-call confirm.
# Leave unset (or set to 0) to hard-block anything that costs money.
HETZNER_MCP_ALLOW_BILLED=
